local profile_fields = {
    { "objective_mm", "Objective Diameter", "objective_mm" },
    { "middle_grey", "Middle Grey", "middle_grey" },
    { "adapt_speed", "Adaptation Speed", "adapt_speed" },
    { "zero_m", "Zero Cap", "zero_m" },
    { "tunneling_parallax", "Tube Parallax", "tunneling_parallax" },
    { "tunneling_min", "Minimum Zoom Tunneling", "tunneling_min" },
    { "tunneling_max", "Maximum Zoom Tunneling", "tunneling_max" },
    { "tracking_speed", "Eye Tracking Speed", "tracking_speed" },
    { "tracking_accel_mm_s2", "Eye Tracking Acceleration", "tracking_accel_mm_s2" },
    { "tracking_limit_mm", "Eye Tracking Travel", "tracking_limit_mm" },
    { "eye_relief_low_mm", "Low Zoom Eye Relief", "eye_relief_low_mm" },
    { "eye_relief_high_mm", "High Zoom Eye Relief", "eye_relief_high_mm" },
    { "exit_pupil_low_mm", "Low Zoom Exit Pupil", "exit_pupil_low_mm" },
    { "exit_pupil_high_mm", "High Zoom Exit Pupil", "exit_pupil_high_mm" },
    { "pupil_parity", "Pupil Parity", "pupil_parity" },
    { "pupil_field_low", "Low Zoom Pupil Field", "pupil_field_low" },
    { "pupil_field_high", "High Zoom Pupil Field", "pupil_field_high" },
    { "transmission", "Light Transmission", "transmission" },
    { "twilight_strength", "Twilight Strength", "twilight_strength" },
    { "physical_min", "Physical Minimum Magnification", "physical_min" },
    { "physical_max", "Physical Maximum Magnification", "physical_max" },
}

local function get_console()
    console = console or _G.get_console()
    return console
end

local function get_bounds(name)
    local ok, bounds = pcall(function()
        return get_console():get_variable_bounds(name)
    end)
    if not ok or not bounds or bounds.min == nil or bounds.max == nil then
        return
    end
    return bounds
end

local function get_float(name)
    local ok, value = pcall(function() return get_console():get_float(name) end)
    return ok and value or 0
end

local function get_integer(name)
    local ok, value = pcall(function() return get_console():get_integer(name) end)
    return ok and value or 0
end

local function get_bool(name)
    local ok, value = pcall(function() return get_console():get_bool(name) end)
    return ok and value or false
end

local function set_number(name, value, integer)
    if integer then
        get_console():execute(string.format("%s %d", name, math.floor(value + 0.5)))
    else
        get_console():execute(string.format("%s %.6f", name, value))
    end
end

local function show_tooltip(name, bounds)
    if not ImGui.BeginItemTooltip() then
        return
    end
    ImGui.PushTextWrapPos(460)
    ImGui.TextWrapped(descriptions[name] or "PiP runtime setting.")
    ImGui.PopTextWrapPos()
    ImGui.Separator()
    ImGui.TextDisabled("Console  " .. name)
    if bounds then
        ImGui.Text(string.format("Minimum %g    Maximum %g", bounds.min, bounds.max))
    end
    ImGui.EndTooltip()
end

local function draw_setting(setting)
    local name, label, kind, speed = unpack(setting)
    local bounds = get_bounds(name)
    if not bounds then
        return
    end
    if kind == "bool" then
        local changed, value = ImGui.Checkbox(label .. "##" .. name, get_bool(name))
        show_tooltip(name, bounds)
        if changed then
            set_number(name, value and 1 or 0, true)
        end
        return
    end
    local integer = kind == "integer"
    local current = integer and get_integer(name) or get_float(name)
    local changed, value = ImGui.DragFloat(label .. "##" .. name, current, speed or 0.01,
        bounds.min, bounds.max, integer and "%.0f" or "%.3f", ImGuiSliderFlags.AlwaysClamp)
    show_tooltip(name, bounds)
    if changed then
        set_number(name, value, integer)
    end
end

local function draw_group(settings)
    for _, setting in ipairs(settings) do
        draw_setting(setting)
    end
end

local function current_profile()
    local getter = rawget(_G, "svp_current_optic_profile")
    if type(getter) ~= "function" then
        return
    end
    local ok, profile = pcall(getter)
    if ok and type(profile) == "table" then
        return profile
    end
end

local function profile_text(label, value)
    ImGui.Text(label)
    ImGui.SameLine(250)
    ImGui.TextWrapped(tostring(value or "none"))
end

local function draw_profile()
    local profile = current_profile()
    if not profile or not profile.valid then
        ImGui.TextDisabled("No active scope profile")
        return
    end
    profile_text("Route", profile.route)
    profile_text("Weapon", profile.weapon)
    profile_text("Scope", profile.scope)
    profile_text("Diagnostic Scope", profile.diagnostic_scope)
    profile_text("Identity", profile.identity_source)
    profile_text("Profile", profile.profile)
    profile_text("Physical Spec", profile.spec)
    profile_text("Physical Model", profile.model)
    profile_text("Binding", profile.binding)
    profile_text("Binding Section", profile.binding_section)
    profile_text("Objective Offset", string.format("%.4f, %.4f, %.4f, %.4f",
        profile.objective_x or 0, profile.objective_y or 0,
        profile.objective_z or 0, profile.objective_w or 0))
    ImGui.TextDisabled("Source  " .. tostring(
        profile.sources and profile.sources.objective_offset or "none"))
    ImGui.Separator()
    for _, field in ipairs(profile_fields) do
        local value = profile[field[1]]
        ImGui.Text(field[2])
        ImGui.SameLine(250)
        ImGui.Text(string.format("%.5g", tonumber(value) or 0))
        ImGui.TextDisabled("Source  " .. tostring(
            profile.sources and profile.sources[field[3]] or "none"))
    end
end

local function render_window()
    ImGui.SetNextWindowSize(vector2():set(900, 760), ImGuiCond.FirstUseEver)
    local expanded, visible = ImGui.Begin(
        "Picture in Picture Settings", show_window, 0)
    show_window = not not visible
    if expanded and ImGui.BeginTabBar("pip_settings_tabs", 0) then
        if ImGui.BeginTabItem("General", true, 0) then
            draw_group(groups.general)
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Optics", true, 0) then
            draw_group(groups.optics)
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Quality", true, 0) then
            draw_group(groups.quality)
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Current Scope Profile", true, 0) then
            draw_profile()
            ImGui.EndTabItem()
        end
        ImGui.EndTabBar()
    end
    ImGui.End()
end

if ImGui and ImGui.Groups and ImGui.Groups.Main and ImGui.Groups.Mods then
    ImGui.Groups.Main.Widget(function()
        if show_window then
            render_window()
        end
    end)
    ImGui.Groups.Mods.Widget(function()
        local _, selected = ImGui.MenuItem("Picture in Picture", nil, show_window, true)
        show_window = not not selected
    end)
end
