    r__svp_reflex_capture = "Render the reflex element correctly through hybrid magnifiers.",
    r__svp_field_stop = "Apply the physical ocular field stop.",
    r__svp_cull = "Restrict world submission to the objective frustum.",
    r__svp_skip_hud_distort = "Keep HUD distortion out of the objective image.",
