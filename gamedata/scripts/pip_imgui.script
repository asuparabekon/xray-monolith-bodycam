    twilight_strength = "Twilight Strength",
    physical_min = "Physical Minimum Magnification",
    physical_max = "Physical Maximum Magnification",
    eye_coupling = "Eye Coupling",
    reticle_illum = "Reticle Illumination",
    magnification_mode = "Magnification Mode",
    magnifications = "Magnifications",
    mod_lane = "Mod Lane",
}
local profile_descriptors

local function get_console()
    console = console or _G.get_console()
    return console
end

-- cvar bounds are fixed at registration; false marks a cvar this build lacks
local bounds_cache = {}

local function get_bounds(name)
    local cached = bounds_cache[name]
    if cached ~= nil then
        return cached or nil
    end
    local ok, bounds = pcall(function()
        return get_console():get_variable_bounds(name)
    end)
    if not ok or not bounds or bounds.min == nil or bounds.max == nil then
        bounds_cache[name] = false
        return
    end
    bounds_cache[name] = bounds
    return bounds
end

local function get_float(name)
    local ok, value = pcall(function() return get_console():get_float(name) end)
    return ok and value or 0
end

local function get_integer(name)
    local ok, value = pcall(function() return get_console():get_integer(name) end)
    return ok and value or 0
end

local function get_bool(name)
    local ok, value = pcall(function() return get_console():get_bool(name) end)
    return ok and value or false
end

local function set_number(name, value, integer)
    if integer then
        get_console():execute(string.format("%s %d", name, math.floor(value + 0.5)))
    else
        get_console():execute(string.format("%s %.6f", name, value))
    end
end

local function show_tooltip(name, bounds)
    if not ImGui.BeginItemTooltip() then
        return
    end
    ImGui.PushTextWrapPos(460)
    ImGui.TextWrapped(descriptions[name] or "PiP runtime setting.")
    ImGui.PopTextWrapPos()
    ImGui.Separator()
    ImGui.TextDisabled("Console  " .. name)
    if bounds then
        ImGui.Text(string.format("Minimum %g    Maximum %g", bounds.min, bounds.max))
    end
    ImGui.EndTooltip()
end

local function draw_setting(setting)
    local name, label, kind, speed = unpack(setting)
    local bounds = get_bounds(name)
    if not bounds then
        return
    end
    if kind == "bool" then
        local changed, value = ImGui.Checkbox(label .. "##" .. name, get_bool(name))
        show_tooltip(name, bounds)
        if changed then
            set_number(name, value and 1 or 0, true)
        end
        return
    end
    local integer = kind == "integer"
    local current = integer and get_integer(name) or get_float(name)
    local changed, value = ImGui.DragFloat(label .. "##" .. name, current, speed or 0.01,
        bounds.min, bounds.max, integer and "%.0f" or "%.3f", ImGuiSliderFlags.AlwaysClamp)
    show_tooltip(name, bounds)
    if changed then
        set_number(name, value, integer)
    end
end

local function draw_group(settings)
    for _, setting in ipairs(settings) do
        draw_setting(setting)
    end
end

local function draw_lens()
    ImGui.TextDisabled("PiP scope glass look. Changes show immediately.")
    draw_group(groups.lens)
    if ImGui.Button("Reset Lens Look##svp_lens_reset", vector2():set(160, 0)) then
        for _, setting in ipairs(groups.lens) do
            local name, kind = setting[1], setting[3]
            if lens_defaults[name] ~= nil then
                set_number(name, lens_defaults[name], kind ~= "float")
            end
        end
    end
end

local function current_profile()
    local getter = rawget(_G, "svp_current_optic_profile")
    if type(getter) ~= "function" then
        return
    end
    local ok, profile = pcall(getter)
    if ok and type(profile) == "table" then
        return profile
    end
end

local function current_profile_descriptors()
    if profile_descriptors then
        return profile_descriptors
    end
    local describe = rawget(_G, "svp_optic_api_describe")
    if type(describe) ~= "function" then
        return {}
    end
    local ok, result = pcall(describe)
    if not ok or type(result) ~= "table" or type(result.fields) ~= "table" then
        return {}
    end
    local values = {}
    for name, descriptor in pairs(result.fields) do
        if type(name) == "string" and type(descriptor) == "table"
            and descriptor.source_required == true then
            values[#values + 1] = {
                name = name,
                descriptor = descriptor,
                index = tonumber(descriptor.index) or math.huge,
            }
        end
    end
    table.sort(values, function(left, right)
        return left.index < right.index
    end)
    profile_descriptors = values
    return values
end

local function profile_value_text(value, descriptor)
    if value == nil then
        return "none"
    end
    if type(value) == "boolean" then
        return value and "true" or "false"
    end
    if type(value) == "number" then
        return string.format("%.5g", value)
    end
    if type(value) ~= "table" then
        return tostring(value)
    end
    if descriptor.type == "array" then
        local parts = {}
        for index, entry in ipairs(value) do
            parts[index] = tostring(entry)
        end
        return table.concat(parts, ", ")
    end
    local parts = {}
    for _, key in ipairs(descriptor.allowed_keys or {}) do
        parts[#parts + 1] = tostring(key) .. "=" .. tostring(value[key])
    end
    return #parts > 0 and table.concat(parts, ", ") or "none"
end

local function profile_text(label, value)
    ImGui.Text(label)
    ImGui.SameLine(250)
    ImGui.TextWrapped(tostring(value or "none"))
end

local function draw_profile()
    local profile = current_profile()
    if not profile or not profile.valid then
        ImGui.TextDisabled("No active scope profile")
        return
    end
    profile_text("Route", profile.route)
    profile_text("Weapon", profile.weapon)
    profile_text("Scope", profile.scope)
    profile_text("Diagnostic Scope", profile.diagnostic_scope)
    profile_text("Identity", profile.identity_source)
    profile_text("Profile", profile.profile_id)
    profile_text("Physical Spec", profile.spec_section)
    profile_text("Physical Model", profile.model)
    profile_text("Binding", profile.binding)
    profile_text("Binding Section", profile.binding_section)
    ImGui.Separator()
    for _, field in ipairs(current_profile_descriptors()) do
        local name = field.name
        ImGui.Text(profile_labels[name] or name)
        ImGui.SameLine(250)
        ImGui.TextWrapped(profile_value_text(profile[name], field.descriptor))
        ImGui.TextDisabled("Source  " .. tostring(
            profile.sources and profile.sources[name] or "none"))
    end
end

local function draw_workbench()
    local workbench = rawget(_G, "pip_optic_workbench")
    if type(workbench) == "table" and type(workbench.draw) == "function" then
        workbench.draw()
        return
    end
    ImGui.TextDisabled("Optics workbench not loaded, start or load a game")
end

local function render_window()
    ImGui.SetNextWindowSize(vector2():set(900, 760), ImGuiCond.FirstUseEver)
    local expanded, visible = ImGui.Begin(
        "Picture in Picture Settings", show_window, 0)
    show_window = not not visible
    if expanded and ImGui.BeginTabBar("pip_settings_tabs", 0) then
        if ImGui.BeginTabItem("General", true, 0) then
            draw_group(groups.general)
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Optics", true, 0) then
            draw_group(groups.optics)
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Quality", true, 0) then
            draw_group(groups.quality)
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Lens", true, 0) then
            draw_lens()
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Current Scope Profile", true, 0) then
            draw_profile()
            ImGui.EndTabItem()
        end
        if ImGui.BeginTabItem("Optics Workbench", true, 0) then
            draw_workbench()
            ImGui.EndTabItem()
        end
        ImGui.EndTabBar()
    end
    ImGui.End()
end

if ImGui and ImGui.Groups and ImGui.Groups.Main and ImGui.Groups.Mods then
    ImGui.Groups.Main.Widget(function()
        if show_window then
            render_window()
        end
    end)
    ImGui.Groups.Mods.Widget(function()
        local _, selected = ImGui.MenuItem("Picture in Picture", nil, show_window, true)
        show_window = not not selected
    end)
end
