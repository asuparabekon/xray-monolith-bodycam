--- Bodycam options tree for Codex modded EXE builds.

options_builder.import_into(this)

local bodycam_path = "gameplay/bodycam"
local bodycam_opt_prefix = "modded_exes/" .. bodycam_path .. "/"

local function get_num(key, def)
    if bodycam and bodycam.get_float then
        return bodycam.get_float(key, def or 0)
    end
    return def or 0
end

local function get_bool(key, def)
    if bodycam and bodycam.get_bool then
        return bodycam.get_bool(key, def and true or false)
    end
    return def and true or false
end

local function set_num(key, id)
    local value = ui_options.opt_temp[bodycam_opt_prefix .. id]
    if value == nil or not (bodycam and bodycam.set_float) then
        return
    end
    bodycam.set_float(key, tonumber(value) or 0)
end

local function set_bool(key, id)
    local value = ui_options.opt_temp[bodycam_opt_prefix .. id]
    if value == nil or not (bodycam and bodycam.set_bool) then
        return
    end
    bodycam.set_bool(key, value and true or false)
end

local function bodycam_num(args)
    args.curr = { get_num, args.key, args.def }
    args.functor = { set_num, args.key, args.id }
    args.prec = args.prec or 1
    args.cmd = false
    return track(args)
end

local function bodycam_bool(args)
    args.curr = { get_bool, args.key, args.def }
    args.functor = { set_bool, args.key, args.id }
    args.cmd = false
    return check(args)
end

local function label(id)
    return "ui_mm_modded_exes_gameplay_bodycam_" .. id
end

PAGE = page {
    { id = "bodycam" },

    line {},
    bodycam_bool { id = "camera_decoupling_enable", text = label("camera_decoupling_enable"), def = true, key = "camera_decoupling_enable" },
    bodycam_bool { id = "vm_spring_enable", text = label("vm_spring_enable"), def = true, key = "vm_spring_enable" },
    bodycam_bool { id = "vm_lowering_enable", text = label("vm_lowering_enable"), def = true, key = "vm_lowering_enable" },
    bodycam_bool { id = "movement_inertia_enable", text = label("movement_inertia_enable"), def = true, key = "movement_inertia_enable" },
    bodycam_bool { id = "movement_inertia_disable_ads", text = label("movement_inertia_disable_ads"), def = true, key = "movement_inertia_disable_ads" },

    line {},
