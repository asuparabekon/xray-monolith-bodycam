--- Bodycam options tree for modded EXE builds.

options_builder.import_into(this)

local bodycam_path = "gameplay/bodycam"
local bodycam_opt_prefix = "modded_exes/" .. bodycam_path .. "/"

local function label(id)
    return "ui_mm_modded_exes_gameplay_bodycam_" .. id
end

local function set_num(id)
    local value = ui_options.opt_temp[bodycam_opt_prefix .. id]
    if value ~= nil then
        bodycam.set_float(id, value)
    end
end

local function set_bool(id)
    local value = ui_options.opt_temp[bodycam_opt_prefix .. id]
    if value ~= nil then
        bodycam.set_bool(id, value)
    end
end

-- The option id is also the bodycam setting name and the label suffix.
local function bodycam_num(args)
    args.text = label(args.id)
    args.curr = { bodycam.get_float, args.id, args.def }
    args.functor = { set_num, args.id }
    args.prec = args.prec or 1
    args.cmd = false
    return track(args)
end

local function bodycam_bool(args)
    args.text = label(args.id)
    args.curr = { bodycam.get_bool, args.id, args.def }
    args.functor = { set_bool, args.id }
    args.cmd = false
    return check(args)
end

-- the exe without bodycam has no bodycam table; keep the page empty there
local function full_page()
    return page {
        { id = "bodycam" },

        line {},
        bodycam_bool { id = "camera_decoupling_enable", def = true },
        bodycam_bool { id = "vm_lowering_enable", def = true },
        bodycam_bool { id = "stalker2_style_arm_ik_enable", def = true },
        bodycam_bool { id = "movement_inertia_enable", def = true },
        bodycam_bool { id = "movement_inertia_disable_ads", def = true },
        bodycam_bool { id = "sprint_transition_enable", def = true },

        line {},
        bodycam_num { id = "hip_camera_deadzone_yaw", def = 1.5, min = 0.0, max = 30.0, step = 0.1 },
        bodycam_num { id = "hip_camera_deadzone_pitch", def = 1.0, min = 0.0, max = 30.0, step = 0.1 },
        bodycam_num { id = "hip_camera_follow_speed", def = 8.0, min = 0.1, max = 30.0, step = 0.1 },
        bodycam_num { id = "hip_camera_max_yaw_offset", def = 19.0, min = 0.0, max = 90.0, step = 0.1 },
        bodycam_num { id = "hip_camera_max_pitch_offset", def = 19.0, min = 0.0, max = 90.0, step = 0.1 },

        line {},
        bodycam_num { id = "movement_acceleration_time", def = 0.42, min = 0.0, max = 2.0, step = 0.1 },
        bodycam_num { id = "movement_deceleration_time", def = 0.38, min = 0.0, max = 2.0, step = 0.1 },
        bodycam_num { id = "movement_turn_response", def = 0.55, min = 0.0, max = 1.0, step = 0.1 },
        bodycam_num { id = "movement_stop_response", def = 0.45, min = 0.0, max = 2.0, step = 0.1 },
        bodycam_num { id = "movement_sprint_speed_scale", def = 1.0, min = 0.1, max = 3.0, step = 0.1 },

        line {},
        bodycam_num { id = "vm_lowering_pitch", def = 0.0, min = -45.0, max = 45.0, step = 0.1 },
        bodycam_num { id = "vm_lowering_yaw", def = 0.0, min = -45.0, max = 45.0, step = 0.1 },
        bodycam_num { id = "vm_lowering_roll", def = 0.0, min = -45.0, max = 45.0, step = 0.1 },
        bodycam_num { id = "vm_lowering_x", def = 0.0, min = -1.0, max = 1.0, step = 0.01, prec = 2 },
        bodycam_num { id = "vm_lowering_y", def = -0.08, min = -1.0, max = 1.0, step = 0.01, prec = 2 },
        bodycam_num { id = "vm_lowering_z", def = 0.10, min = -1.0, max = 1.0, step = 0.01, prec = 2 },
        bodycam_num { id = "vm_lowering_slow_walk_influence", def = 0.5, min = 0.0, max = 1.0, step = 0.1 },
        bodycam_num { id = "vm_lowering_walk_influence", def = 1.0, min = 0.0, max = 1.0, step = 0.1 },
        bodycam_num { id = "vm_lowering_movement_influence", def = 1.0, min = 0.0, max = 1.0, step = 0.1 },
        bodycam_num { id = "vm_lowering_enter_speed", def = 0.05, min = 0.0, max = 1.0, step = 0.01, prec = 2 },
        bodycam_num { id = "vm_lowering_return_speed", def = 0.4, min = 0.0, max = 1.0, step = 0.1 },

        line {},
        bodycam_num { id = "sprint_camera_sway_strength", def = 1.5, min = 0.0, max = 2.0, step = 0.1 },
        bodycam_num { id = "sprint_camera_sway_smoothing", def = 1.0, min = 0.0, max = 1.0, step = 0.1 },

        line {},
        bodycam_bool { id = "fire_impulse_enable", def = true },
        bodycam_num { id = "hip_fire_weapon_impulse", def = 5.0, min = 0.0, max = 5.0, step = 0.1 },
        bodycam_num { id = "ads_fire_weapon_impulse", def = 1.35, min = 0.0, max = 5.0, step = 0.1 },
    }
end

PAGE = rawget(_G, "bodycam") and full_page() or page { { id = "bodycam" }, line {} }
