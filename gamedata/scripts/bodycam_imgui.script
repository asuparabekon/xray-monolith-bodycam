for variation = 1, 4 do
    binding_descriptions["classic_regrip_" .. variation .. "_intensity"] = string.format(
        "Strength of regrip variation %d, for both gun and camera. 0 removes its motion; 1 is full strength. Does not change how often it is picked.",
        variation)
end

local function get_binding(binding)
    if binding.type == "bool" then
        return bodycam.get_bool(binding.name, binding.default)
    end
    return bodycam.get_float(binding.name, binding.default)
end

local function set_binding(binding, value)
    if binding.type == "bool" then
        bodycam.set_bool(binding.name, value)
    else
        bodycam.set_float(binding.name, value)
    end
end

local function read_binding(ini, section, binding)
    return ini:r_value(section, binding.name, binding.type == "bool" and 1 or 2, binding.default)
end

local function load_bindings()
    if bindings then
        return
    end

    bindings = {}
    for _, binding in ipairs(bodycam.get_bindings()) do
        if string.sub(binding.name, 1, 10) ~= "reference_" and binding.name ~= "scope_effects_enable" then
            binding.widget_id = "##" .. binding.name
            table.insert(bindings, binding)
            binding_by_name[binding.name] = binding
        end
    end

    local matches_default = true
    for _, binding in ipairs(bindings) do
        local value = get_binding(binding)
        if binding.type == "bool" then
            matches_default = value == binding.default
        else
            matches_default = math.abs(value - binding.default) <= 0.0001
        end
        if not matches_default then
            break
        end
    end
    if matches_default then
        selected_preset = { kind = "builtin", id = "default", name = "Default" }
    end
end

local function preset_storage()
    if not preset_ini then
        preset_ini = ini_file_ex(preset_file, true)
    end
    return preset_ini
end

local function clean_preset_name(name)
    name = tostring(name or "")
    name = string.gsub(name, "[\r\n%[%]=;]", " ")
    name = string.gsub(name, "^%s+", "")
    name = string.gsub(name, "%s+$", "")
    name = string.gsub(name, "%s%s+", " ")
    return string.sub(name, 1, max_preset_name_length)
end

local function read_user_presets(ini)
    local result = {}
    if ini:section_exist(preset_index_section) then
        local count = ini:line_count(preset_index_section)
        for index = 0, count - 1 do
            local exists, id, name = ini:r_line(preset_index_section, index, "", "")
            if exists and string.sub(id, 1, #preset_section_prefix) == preset_section_prefix then
                table.insert(result, {
                    kind = "user",
                    id = id,
                    name = clean_preset_name(name),
                    section = id,
                })
            end
        end
    end
    table.sort(result, function(left, right)
        return string.lower(left.name) < string.lower(right.name)
    end)
    return result
end

local function find_user_preset(id)
    for _, preset in ipairs(user_presets) do
        if preset.id == id then
            return preset
        end
    end
end

local function find_user_preset_by_name(name)
    local needle = string.lower(clean_preset_name(name))
    for _, preset in ipairs(user_presets) do
        if string.lower(preset.name) == needle then
            return preset
        end
    end
end

local function write_preset_values(ini, section, source_values)
    for _, binding in ipairs(bindings) do
        local value
        if source_values and source_values[binding.name] ~= nil then
            value = source_values[binding.name]
        else
            value = get_binding(binding)
        end
        ini:w_value(section, binding.name, value)
    end
end

local function create_user_preset(name, source_values)
    local ini = preset_storage()
    name = clean_preset_name(name)
    if name == "" then
        return nil, "Enter a preset name."
    end
    if find_user_preset_by_name(name) then
        return nil, "A user preset with that name already exists."
    end
    if #user_presets >= max_user_presets then
        return nil, string.format("The %d-preset limit has been reached.", max_user_presets)
    end

    local next_id = ini:r_value(preset_index_section, "next_id", 2, 1)
    local id = preset_section_prefix .. math.floor(next_id)
    ini:w_value(preset_index_section, "next_id", math.floor(next_id) + 1)
    ini:w_value(preset_index_section, id, name)
    write_preset_values(ini, id, source_values)
    ini:save()

    user_presets = read_user_presets(ini)
    return find_user_preset(id)
end

local function load_user_presets()
    if user_presets then
        return
    end
    local ini = preset_storage()
    preset_auto_update = false
    if ini:section_exist(preset_index_section) then
        preset_auto_update = ini:r_value(preset_index_section, "auto_update", 1, false)
    end
    user_presets = read_user_presets(ini)
end

local function save_user_preset(preset)
    if not preset or preset.kind ~= "user" then
        return
    end
    local ini = preset_storage()
    write_preset_values(ini, preset.section)
    ini:save()
    preset_save_due_time = nil
end

local function schedule_user_preset_save()
    if time_global() < preset_apply_guard_until then
        return
    end

    if selected_preset.kind == "user" then
        if preset_auto_update then
            preset_save_due_time = time_global() + preset_save_delay_ms
        end
    else
        selected_preset = modified_preset
    end
end

local function preserve_pending_user_preset()
    if preset_save_due_time then
        save_user_preset(selected_preset)
    end
end

local function apply_binding_values(values)
    for name, value in pairs(values or {}) do
        local binding = binding_by_name[name]
        if binding then
            set_binding(binding, value)
        end
    end
end

local function apply_builtin_preset(preset)
    preserve_pending_user_preset()
    selected_preset = { kind = "builtin", id = preset.id, name = preset.name }
    preset_save_due_time = nil
    preset_apply_guard_until = time_global() + preset_apply_guard_ms
    bodycam.apply_preset(preset.engine_preset)
    apply_binding_values(preset.values)
end

local function delete_user_preset(preset)
    if not preset or preset.kind ~= "user" then
        return
    end

    local ini = preset_storage()
    if ini:section_exist(preset.section) then
        ini:remove_section(preset.section)
    end
    ini:remove_line(preset_index_section, preset.id)
    ini:save()
    user_presets = read_user_presets(ini)
    selected_preset = modified_preset
    preset_save_due_time = nil
end

local function rename_user_preset(preset, name)
    name = clean_preset_name(name)
    local duplicate = find_user_preset_by_name(name)
    if not preset or preset.kind ~= "user" then
        return false, "The selected preset is unavailable."
    end
    if name == "" then
        return false, "Enter a preset name."
    end
    if duplicate and duplicate.id ~= preset.id then
        return false, "A user preset with that name already exists."
    end

    local ini = preset_storage()
    ini:w_value(preset_index_section, preset.id, name)
    ini:save()
    user_presets = read_user_presets(ini)
    selected_preset = find_user_preset(preset.id)
    return true
end

local function capture_current_values()
    local values = {}
    for _, binding in ipairs(bindings) do
        values[binding.name] = get_binding(binding)
    end
    return values
end

local function read_user_preset_values(preset)
    local ini = preset_storage()
    if not preset or not ini:section_exist(preset.section) then
        return nil
    end

    local values = {}
    for _, binding in ipairs(bindings) do
        values[binding.name] = read_binding(ini, preset.section, binding)
    end
    return values
end

local function apply_user_preset(preset)
    preserve_pending_user_preset()
    local values = read_user_preset_values(preset)
    if not values then
        return
    end

    selected_preset = {
        kind = "user",
        id = preset.id,
        name = preset.name,
        section = preset.section,
    }
    preset_save_due_time = nil
    preset_apply_guard_until = time_global() + preset_apply_guard_ms
    bodycam.apply_preset(engine_preset_default)
    apply_binding_values(values)
end

local function find_builtin_preset(id)
    for _, preset in ipairs(builtin_presets) do
        if preset.id == id then
            return preset
        end
    end
end

local function capture_builtin_preset_values(preset)
    if not preset then
        return nil
    end

    local current = capture_current_values()
    bodycam.apply_preset(preset.engine_preset)
    apply_binding_values(preset.values)
    local values = capture_current_values()
    apply_binding_values(current)
    return values
end

local function copy_source_values(source)
    if source.kind == "current" then
        return capture_current_values()
    elseif source.kind == "builtin" then
        return capture_builtin_preset_values(find_builtin_preset(source.id))
    elseif source.kind == "user" then
        return read_user_preset_values(find_user_preset(source.id))
    end
end

local function select_copy_source(kind, id, name)
    new_preset_source = { kind = kind, id = id, name = name }
end

local shared_options_section = "bodycam_shared_features"
-- The value the ini copy holds; nil until loaded.
local scope_effects_saved = nil

-- The ini copy survives the stock exe dropping the bodycam cvars from user.ltx, which leaves the cvar at its
-- default (on). An off cvar can only come from user.ltx or the console, so it wins over the ini copy.
local function load_shared_options()
    if scope_effects_saved ~= nil then
        return
    end

    scope_effects_saved = true
    local ini = preset_storage()
    if ini:line_exist(shared_options_section, "scope_effects_enable") then
        scope_effects_saved = ini:r_value(shared_options_section, "scope_effects_enable", 1, true)
        if bodycam.get_bool("scope_effects_enable", true) then
            bodycam.set_bool("scope_effects_enable", scope_effects_saved)
        end
    end
end

-- Writes every change of the cvar (menu, console or user.ltx) through to the ini copy.
local function sync_shared_options()
    load_shared_options()
    local value = bodycam.get_bool("scope_effects_enable", true)
    if value ~= scope_effects_saved then
        scope_effects_saved = value
        local ini = preset_storage()
        ini:w_value(shared_options_section, "scope_effects_enable", value)
        ini:save()
    end
end

-- A tooltip sizes itself to its content, so wrapped text needs a set width.
local tooltip_wrap_width = 430

local function tooltip_text(text)
    ImGui.PushTextWrapPos(tooltip_wrap_width)
    ImGui.TextWrapped(text)
    ImGui.PopTextWrapPos()
end

local function show_tooltip(text)
    if ImGui.BeginItemTooltip() then
        tooltip_text(text)
        ImGui.EndTooltip()
    end
end

local function draw_scope_effects()
    local changed, value = ImGui.Checkbox("Bodycam scope effects##scope_effects_enable",
        bodycam.get_bool("scope_effects_enable", true))
    show_tooltip("Draws the lens, tunnel, exit pupil, reflections and light ghosts in scopes. GAMMA still sets zoom and reticles.")
    if changed then
        bodycam.set_bool("scope_effects_enable", value)
        sync_shared_options()
    end
end

local function actor_on_update()
    sync_shared_options()
    if preset_save_due_time and time_global() >= preset_save_due_time then
        save_user_preset(selected_preset)
    end
end

local function actor_on_net_destroy()
    preserve_pending_user_preset()
end

local function show_binding_tooltip(binding)
    if ImGui.BeginItemTooltip() then
        tooltip_text(binding_descriptions[binding.name])
        ImGui.Separator()
        ImGui.TextDisabled("Console: " .. binding.console_name)
        if binding.type == "float" then
            ImGui.Text(string.format("Minimum: %g    Maximum: %g    Default: %g",
                binding.min, binding.max, binding.default))
        else
            ImGui.Text("Default: " .. (binding.default and "On" or "Off"))
        end
        ImGui.TextDisabled("Right-click the control to reset it.")
        ImGui.EndTooltip()
    end
end

local function float_format(binding)
    local span = binding.max - binding.min
    if span <= 0.5 then
        return "%.3f"
    elseif span <= 2.0 then
        return "%.2f"
    end
    return "%.1f"
end

local function draw_binding(binding, label)
    ImGui.TableNextRow(ImGuiTableRowFlags.None, 0)
    ImGui.TableSetColumnIndex(0)
    ImGui.Text(label)
    show_binding_tooltip(binding)
    ImGui.TableSetColumnIndex(1)

    local current = get_binding(binding)
    local changed, value
    if binding.type == "bool" then
        changed, value = ImGui.Checkbox(binding.widget_id, current)
    else
        changed, value = ImGui.SliderFloat(binding.widget_id, current, binding.min, binding.max,
            float_format(binding), ImGuiSliderFlags.None)
    end
    local reset = ImGui.IsItemClicked(ImGuiMouseButton.Right)
    show_binding_tooltip(binding)
    if changed or reset then
        if reset then
            value = binding.default
        end
        set_binding(binding, value)
        schedule_user_preset_save()
    end
end

local function draw_settings_table(id, settings)
    if not ImGui.BeginTable(id, 2, ImGuiTableFlags.None, zero_size, 0) then
        return
    end

    ImGui.TableSetupColumn("Setting", ImGuiTableColumnFlags.None, 0.62, 0)
    ImGui.TableSetupColumn("Value", ImGuiTableColumnFlags.None, 0.38, 0)
    for _, setting in ipairs(settings) do
        local binding = binding_by_name[setting[1]]
        if binding then
            draw_binding(binding, setting[2])
        end
    end
    ImGui.EndTable()
end

-- Draws the built-in and user preset entries of an open combo. `selection`
-- is the entry to highlight; on_pick(kind, preset) runs for a clicked entry.
local function draw_preset_entries(id_prefix, selection, on_pick)
    local function draw_group(kind, title, presets)
        ImGui.TextDisabled(title)
        for _, preset in ipairs(presets) do
            local selected = selection.kind == kind and selection.id == preset.id
            if ImGui.Selectable(preset.name .. "##" .. id_prefix .. kind .. "_" .. preset.id, selected,
                ImGuiSelectableFlags.None, zero_size) then
                on_pick(kind, preset)
            end
            if selected then
                ImGui.SetItemDefaultFocus()
            end
        end
    end

    draw_group("builtin", "Built-in", builtin_presets)
    if #user_presets > 0 then
        ImGui.Separator()
        draw_group("user", "User", user_presets)
    end
end

local function draw_copy_source_selector()
    ImGui.SetNextItemWidth(360)
    if not ImGui.BeginCombo(
        "##bodycam_copy_source",
        new_preset_source.name,
        ImGuiComboFlags.None) then
        return
    end

    local selected = new_preset_source.kind == "current"
    if ImGui.Selectable(
        "Current Settings##copy_current",
        selected,
        ImGuiSelectableFlags.None,
        zero_size) then
        select_copy_source("current", "current", "Current Settings")
    end
    if selected then
        ImGui.SetItemDefaultFocus()
    end

    ImGui.Separator()
    draw_preset_entries("copy_", new_preset_source, function(kind, preset)
        select_copy_source(kind, preset.id, preset.name)
    end)
    ImGui.EndCombo()
end

local function draw_preset_name_input(id, hint)
    ImGui.SetNextItemWidth(360)
    local name, submitted = ImGui.InputTextWithHint(
        id,
        hint,
        preset_dialog_name,
        preset_name_buffer_size,
        ImGuiInputTextFlags.EnterReturnsTrue)
    preset_dialog_name = name
    return submitted
end

local function draw_dialog_message()
    if preset_dialog_message then
        ImGui.Spacing()
        ImGui.TextColored(
            fcolor():set(1, 0.45, 0.35, 1),
            preset_dialog_message)
    end
end

local function draw_dialog_separator()
    ImGui.Spacing()
    ImGui.Separator()
    ImGui.Spacing()
end

local function draw_dialog_cancel()
    ImGui.SameLine(0, 8)
    if ImGui.Button("Cancel", vector2():set(110, 0)) then
        preset_dialog_message = nil
        ImGui.CloseCurrentPopup()
    end
end

local function draw_new_preset_dialog()
    local expanded = ImGui.BeginPopupModal(
        "New Bodycam Preset",
        true,
        ImGuiWindowFlags.AlwaysAutoResize)
    if not expanded then
        return
    end

    ImGui.Text("Preset name")
    if ImGui.IsWindowAppearing() then
        ImGui.SetKeyboardFocusHere(0)
    end
    local submitted = draw_preset_name_input(
        "##bodycam_new_preset_name",
        "Enter a name")
    ImGui.Spacing()
    ImGui.Text("Copy from preset:")
    draw_copy_source_selector()

    draw_dialog_message()
    draw_dialog_separator()
    if ImGui.Button("Create", vector2():set(110, 0)) or submitted then
        preserve_pending_user_preset()
        local values = copy_source_values(new_preset_source)
        if values then
            local preset, message = create_user_preset(preset_dialog_name, values)
            if preset then
                apply_user_preset(preset)
                preset_message = "Preset created."
                preset_dialog_message = nil
                ImGui.CloseCurrentPopup()
            else
                preset_dialog_message = message
            end
        else
            preset_dialog_message = "The source preset is unavailable."
        end
    end
    draw_dialog_cancel()
    ImGui.EndPopup()
end

local function draw_rename_preset_dialog()
    local expanded = ImGui.BeginPopupModal(
        "Rename Bodycam Preset",
        true,
        ImGuiWindowFlags.AlwaysAutoResize)
    if not expanded then
        return
    end

    local preset = find_user_preset(rename_preset_id)
    if not preset then
        ImGui.TextDisabled("The selected preset is no longer available.")
        if ImGui.Button("Close", vector2():set(110, 0)) then
            ImGui.CloseCurrentPopup()
        end
        ImGui.EndPopup()
        return
    end

    ImGui.Text("Preset name")
    if ImGui.IsWindowAppearing() then
        ImGui.SetKeyboardFocusHere(0)
    end
    local submitted = draw_preset_name_input(
        "##bodycam_rename_preset_name",
        "Enter a new name")

    draw_dialog_message()
    draw_dialog_separator()
    if ImGui.Button("Rename", vector2():set(110, 0)) or submitted then
        local renamed, message = rename_user_preset(
            preset,
            preset_dialog_name)
        if renamed then
            preset_message = "Preset renamed."
            preset_dialog_message = nil
            ImGui.CloseCurrentPopup()
        else
            preset_dialog_message = message
        end
    end
    draw_dialog_cancel()
    ImGui.EndPopup()
end

local function draw_delete_preset_dialog()
    local expanded = ImGui.BeginPopupModal(
        "Delete Bodycam Preset",
        true,
        ImGuiWindowFlags.AlwaysAutoResize)
    if not expanded then
        return
    end

    local preset = find_user_preset(delete_preset_id)
    if preset then
        ImGui.TextWrapped(
            "Delete preset '" .. preset.name .. "'? This cannot be undone.")
    else
        ImGui.TextDisabled("The selected preset is no longer available.")
    end

    draw_dialog_separator()
    ImGui.BeginDisabled(not preset)
    if ImGui.Button("Delete", vector2():set(110, 0)) then
        delete_user_preset(preset)
        preset_message = "Preset deleted."
        ImGui.CloseCurrentPopup()
    end
    ImGui.EndDisabled()
    draw_dialog_cancel()
    ImGui.EndPopup()
end

local function draw_presets()
    load_user_presets()

    ImGui.TextDisabled("PRESET")
    ImGui.SetNextItemWidth(320)
    if ImGui.BeginCombo("##bodycam_preset", selected_preset.name, ImGuiComboFlags.None) then
        draw_preset_entries("", selected_preset, function(kind, preset)
            if kind == "builtin" then
                apply_builtin_preset(preset)
            else
                apply_user_preset(preset)
            end
            preset_message = nil
        end)
        ImGui.EndCombo()
    end

    ImGui.SameLine(0, 8)
    if ImGui.Button("New", vector2():set(72, 0)) then
        preserve_pending_user_preset()
        preset_dialog_name = ""
        preset_dialog_message = nil
        if selected_preset.kind == "builtin" or selected_preset.kind == "user" then
            select_copy_source(
                selected_preset.kind,
                selected_preset.id,
                selected_preset.name)
        else
            select_copy_source("current", "current", "Current Settings")
        end
        ImGui.OpenPopup("New Bodycam Preset")
    end

    local is_user_preset = selected_preset.kind == "user"
    local auto_update_changed, auto_update = ImGui.Checkbox("Auto-update", preset_auto_update)
    if auto_update_changed then
        preset_auto_update = auto_update
        local ini = preset_storage()
        ini:w_value(preset_index_section, "auto_update", auto_update)
        ini:save()
        if auto_update and is_user_preset then
            preset_save_due_time = time_global() + preset_save_delay_ms
        else
            preset_save_due_time = nil
        end
    end
    show_tooltip("Saves changes to the selected user preset as you make them. Turn off to save with the Update button.")

    ImGui.SameLine(0, 8)
    ImGui.BeginDisabled(not is_user_preset or preset_auto_update)
    if ImGui.Button("Update", vector2():set(78, 0)) then
        save_user_preset(selected_preset)
        preset_message = "Preset updated."
    end
    ImGui.EndDisabled()

    ImGui.SameLine(0, 8)
    ImGui.BeginDisabled(not is_user_preset)
    if ImGui.Button("Rename", vector2():set(78, 0)) then
        rename_preset_id = selected_preset.id
        preset_dialog_name = selected_preset.name
        preset_dialog_message = nil
        ImGui.OpenPopup("Rename Bodycam Preset")
    end
    ImGui.SameLine(0, 8)
    if ImGui.Button("Delete", vector2():set(78, 0)) then
        delete_preset_id = selected_preset.id
        preset_dialog_message = nil
        ImGui.OpenPopup("Delete Bodycam Preset")
    end
    ImGui.EndDisabled()

    if preset_message then
        ImGui.TextDisabled(preset_message)
    end
    draw_new_preset_dialog()
    draw_rename_preset_dialog()
    draw_delete_preset_dialog()
end

local function selected_lag_model()
    return bodycam.get_bool("camera_continuous_follow_enable", false) and "follow" or "deadzone"
end

-- Sections of the lag model that is not selected are not drawn.
local function draw_sections(tab_id, sections)
    local lag_model = selected_lag_model()
    local first = true
    for _, section in ipairs(sections) do
        if not section.lag_model or section.lag_model == lag_model then
            if not first then
                ImGui.Spacing()
                ImGui.Separator()
                ImGui.Spacing()
            end
            first = false
            ImGui.TextDisabled(section.name)
            ImGui.Spacing()
            draw_settings_table("bodycam_" .. tab_id .. "_" .. section.name, section.settings)
        end
    end
end

local function draw_navigation()
    ImGui.TextDisabled("FEATURES")
    ImGui.Spacing()
    for index, feature in ipairs(feature_tabs) do
        local clicked = ImGui.Selectable(
            feature.name .. "##bodycam_nav_" .. index,
            selected_feature == index,
            ImGuiSelectableFlags.None,
            nav_row_size)
        if clicked then
            selected_feature = index
        end
    end

    ImGui.Spacing()
    ImGui.Separator()
    ImGui.Spacing()
    local diagnostics_index = #feature_tabs + 1
    local clicked = ImGui.Selectable(
        "Diagnostics##bodycam_nav_diagnostics",
        selected_feature == diagnostics_index,
        ImGuiSelectableFlags.None,
        nav_row_size)
    if clicked then
        selected_feature = diagnostics_index
    end
end

local function draw_diagnostics()
    draw_sections("Diagnostics", diagnostics_sections)

    ImGui.Spacing()
    ImGui.Separator()
    ImGui.Spacing()
    if ImGui.Button("Dump Runtime State", vector2():set(160, 0)) then
        bodycam.dump()
    end
end

-- Camera Decoupling's lag model, stored as camera_continuous_follow_enable.
local lag_models = { { id = "deadzone", name = "Deadzone" }, { id = "follow", name = "Reference follow" } }
local function draw_lag_model()
    local selected = selected_lag_model()
    ImGui.SetNextItemWidth(180)
    if ImGui.BeginCombo("Lag Model", selected == "follow" and lag_models[2].name or lag_models[1].name, ImGuiComboFlags.None) then
        for _, model in ipairs(lag_models) do
            if ImGui.Selectable(model.name, selected == model.id, ImGuiSelectableFlags.None, zero_size) then
                bodycam.set_bool("camera_continuous_follow_enable", model.id == "follow")
                schedule_user_preset_save()
            end
        end
        ImGui.EndCombo()
    end
    show_binding_tooltip(binding_by_name.camera_continuous_follow_enable)
end

local function draw_selected_feature()
    draw_presets()
    ImGui.Spacing()
    ImGui.Separator()
    ImGui.Spacing()

    local feature = feature_tabs[selected_feature]
    if feature then
        if feature.toggle then
            draw_settings_table(feature.toggle_id, feature.toggle_settings)
            ImGui.Spacing()
        end
        if feature.lag_model then
            draw_lag_model()
            ImGui.Spacing()
        end
        if feature.toggle or feature.lag_model then
            ImGui.Separator()
            ImGui.Spacing()
        end
        draw_sections(feature.name, feature.sections)
    else
        draw_diagnostics()
    end
end

local function draw_bodycam_settings()
    sync_shared_options()
    draw_scope_effects()
    ImGui.Separator()
    ImGui.Spacing()
    if not ImGui.BeginTable(
        "bodycam_settings_layout",
        2,
        ImGuiTableFlags.BordersInnerV,
        zero_size,
        0) then
        return
    end

    ImGui.TableSetupColumn("Features", ImGuiTableColumnFlags.WidthFixed, 220, 0)
    ImGui.TableSetupColumn("Options", ImGuiTableColumnFlags.WidthStretch, 0, 0)
    ImGui.TableNextRow(ImGuiTableRowFlags.None, 0)
    ImGui.TableSetColumnIndex(0)
    draw_navigation()
    ImGui.TableSetColumnIndex(1)
    draw_selected_feature()
    ImGui.EndTable()
end

local function render_bodycam_window()
    ImGui.SetNextWindowSize(vector2():set(1020, 720), ImGuiCond.FirstUseEver)
    local expanded, visible = ImGui.Begin("Bodycam Settings", show_bodycam_window, ImGuiWindowFlags.None)
    show_bodycam_window = visible

    if expanded then
        load_bindings()
        draw_bodycam_settings()
    end
    ImGui.End()
end

if ImGui and ImGui.Groups and ImGui.Groups.Main and ImGui.Groups.Mods then
    ImGui.Groups.Main.Widget(function()
        if show_bodycam_window then
            render_bodycam_window()
        end
    end)

    ImGui.Groups.Mods.Widget(function()
        _, show_bodycam_window = ImGui.MenuItem("Bodycam", nil, show_bodycam_window, true)
    end)
end

function on_game_start()
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end
