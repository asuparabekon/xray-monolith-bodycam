        name = "Debugging",
        settings = {
            { "impulse_debug_enable", "Impulse Debug Output" },
        },
    },
}

local assigned_names = {}
for _, tab in ipairs(feature_tabs) do
    if tab.toggle then
        assigned_names[tab.toggle[1]] = true
    end
    for _, section in ipairs(tab.sections) do
        for _, setting in ipairs(section.settings) do
            assigned_names[setting[1]] = true
        end
    end
end
for _, section in ipairs(diagnostics_sections) do
    for _, setting in ipairs(section.settings) do
        assigned_names[setting[1]] = true
    end
end

