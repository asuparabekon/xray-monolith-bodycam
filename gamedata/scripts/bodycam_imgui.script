local function human_name(name)
    local words = {}
    for word in string.gmatch(name, "[^_]+") do
        local replacement = word_names[word]
        if replacement then
            table.insert(words, replacement)
        else
            table.insert(words, string.upper(string.sub(word, 1, 1)) .. string.sub(word, 2))
        end
    end
    return table.concat(words, " ")
end

local function load_bindings()
    if bindings then
        return true
    end
    if not bodycam or not bodycam.get_bindings then
        return false
    end

    local ok, result = pcall(bodycam.get_bindings)
    if not ok or not result then
        return false
    end

    bindings = result
    for _, binding in ipairs(bindings) do
        binding_by_name[binding.name] = binding
    end
    return true
end

local function custom_storage()
    return axr_main and axr_main.config
end

local function save_custom_preset()
    local ini = custom_storage()
    if not ini or not load_bindings() then
        return
    end

    for _, binding in ipairs(bindings) do
        if binding.type == "bool" then
            ini:w_value(custom_section, binding.name, bodycam.get_bool(binding.name, binding.default))
        else
            ini:w_value(custom_section, binding.name, bodycam.get_float(binding.name, binding.default))
        end
    end
    ini:save()
    custom_save_due_time = nil
end

local function schedule_custom_save()
    custom_save_due_time = time_global() + custom_save_delay_ms
end

local function apply_custom_preset()
    local ini = custom_storage()
    if not ini or not ini:section_exist(custom_section) or not load_bindings() then
        return
    end

    for _, binding in ipairs(bindings) do
        if ini:line_exist(custom_section, binding.name) then
            if binding.type == "bool" then
                bodycam.set_bool(binding.name,
                    ini:r_value(custom_section, binding.name, 1, binding.default))
            else
                bodycam.set_float(binding.name,
                    ini:r_value(custom_section, binding.name, 2, binding.default))
            end
        end
    end
end

local function actor_on_update()
    if custom_save_due_time and time_global() >= custom_save_due_time then
        save_custom_preset()
    end
end

local function preserve_pending_custom_preset()
    if custom_save_due_time then
        save_custom_preset()
    end
end

local function show_binding_tooltip(binding)
    if ImGui.BeginItemTooltip() then
        ImGui.PushTextWrapPos(430)
        ImGui.TextWrapped(binding_descriptions[binding.name] or ("Adjusts " .. human_name(binding.name) .. "."))
        ImGui.PopTextWrapPos()
        ImGui.Separator()
        ImGui.TextDisabled("Console: " .. binding.console_name)
        if binding.type == "float" then
            ImGui.Text(string.format("Minimum: %g    Maximum: %g    Default: %g",
                binding.min, binding.max, binding.default))
        else
            ImGui.Text(string.format("Minimum: 0 (Off)    Maximum: 1 (On)    Default: %s",
                binding.default and "On" or "Off"))
        end
        ImGui.TextDisabled("Right-click the control to reset it.")
        ImGui.EndTooltip()
    end
end

local function float_format(binding)
    local span = binding.max - binding.min
    if span <= 0.5 then
        return "%.3f"
    elseif span <= 2.0 then
        return "%.2f"
    end
    return "%.1f"
end

local function drag_speed(binding)
    local span = binding.max - binding.min
    if span <= 0.5 then
        return 0.001
    elseif span <= 2.0 then
        return 0.01
    end
    return 0.1
end

local function draw_binding(binding, label, use_slider)
    ImGui.TableNextRow(ImGuiTableRowFlags.None, 0)
    ImGui.TableSetColumnIndex(0)
    ImGui.Text(label)
    show_binding_tooltip(binding)
    ImGui.TableSetColumnIndex(1)

    if binding.type == "bool" then
        local current = bodycam.get_bool(binding.name, false)
        local changed, value = ImGui.Checkbox("##" .. binding.name, current)
        local reset = ImGui.IsItemClicked(ImGuiMouseButton.Right)
        show_binding_tooltip(binding)
        if changed or reset then
            if reset then
                value = binding.default
            end
            bodycam.set_bool(binding.name, value)
            schedule_custom_save()
        end
        return
    end

    local current = bodycam.get_float(binding.name, 0)
    local changed, value
    if use_slider then
        changed, value = ImGui.SliderFloat("##" .. binding.name, current, binding.min, binding.max,
            float_format(binding), ImGuiSliderFlags.None)
    else
        changed, value = ImGui.DragFloat("##" .. binding.name, current, drag_speed(binding), binding.min,
            binding.max, float_format(binding), ImGuiSliderFlags.None)
    end
    local reset = ImGui.IsItemClicked(ImGuiMouseButton.Right)
    show_binding_tooltip(binding)
    if changed or reset then
        if reset then
            value = binding.default
        end
        bodycam.set_float(binding.name, value)
        schedule_custom_save()
    end
end

local function draw_settings_table(id, settings, use_slider)
    if not ImGui.BeginTable(id, 2, ImGuiTableFlags.None, vector2():set(0, 0), 0) then
        return
    end

    ImGui.TableSetupColumn("Setting", ImGuiTableColumnFlags.None, 0.62, 0)
    ImGui.TableSetupColumn("Value", ImGuiTableColumnFlags.None, 0.38, 0)
    for _, setting in ipairs(settings) do
        local binding = binding_by_name[setting[1]]
        if binding then
            draw_binding(binding, setting[2], use_slider)
        end
    end
    ImGui.EndTable()
end

local function draw_presets()
    if ImGui.Button("Default", vector2():set(110, 0)) then
        preserve_pending_custom_preset()
        bodycam.apply_preset(2)
    end
    ImGui.SameLine(0, 8)
    if ImGui.Button("Balanced", vector2():set(110, 0)) then
        preserve_pending_custom_preset()
        bodycam.apply_preset(1)
    end
    ImGui.SameLine(0, 8)
    if ImGui.Button("Cinematic", vector2():set(110, 0)) then
        preserve_pending_custom_preset()
        bodycam.apply_preset(3)
    end
    ImGui.SameLine(0, 8)
    if ImGui.Button("Custom", vector2():set(110, 0)) then
        preserve_pending_custom_preset()
        apply_custom_preset()
    end
end

local function draw_sections(tab_id, sections)
    for index, section in ipairs(sections) do
        if index > 1 then
            ImGui.Spacing()
            ImGui.Separator()
            ImGui.Spacing()
        end
        ImGui.TextDisabled(section.name)
        ImGui.Spacing()
        draw_settings_table("bodycam_" .. tab_id .. "_" .. section.name, section.settings, true)
    end
end

local function draw_navigation()
    ImGui.TextDisabled("FEATURES")
    ImGui.Spacing()
    for index, feature in ipairs(feature_tabs) do
        local clicked = ImGui.Selectable(
            feature.name .. "##bodycam_nav_" .. index,
            selected_feature == index,
            ImGuiSelectableFlags.None,
            vector2():set(0, 32))
        if clicked then
            selected_feature = index
        end
    end

    ImGui.Spacing()
    ImGui.Separator()
    ImGui.Spacing()
    local diagnostics_index = #feature_tabs + 1
    local clicked = ImGui.Selectable(
        "Diagnostics##bodycam_nav_diagnostics",
        selected_feature == diagnostics_index,
        ImGuiSelectableFlags.None,
        vector2():set(0, 32))
    if clicked then
        selected_feature = diagnostics_index
    end
end

local function draw_diagnostics()
    draw_sections("Diagnostics", diagnostics_sections)
    local unassigned = {}
    for _, binding in ipairs(bindings) do
        if not assigned_names[binding.name] then
            table.insert(unassigned, { binding.name, human_name(binding.name) })
        end
    end
    if #unassigned > 0 and ImGui.CollapsingHeader("Unassigned Settings", ImGuiTreeNodeFlags.None) then
        draw_settings_table("bodycam_unassigned", unassigned, false)
    end

    ImGui.Spacing()
    ImGui.Separator()
    ImGui.Spacing()
    if ImGui.Button("Dump Runtime State", vector2():set(160, 0)) then
        bodycam.dump()
    end
end

local function draw_selected_feature()
    draw_presets()
    ImGui.Spacing()
    ImGui.Separator()
    ImGui.Spacing()

    local feature = feature_tabs[selected_feature]
    if feature then
        if feature.toggle then
            draw_settings_table("bodycam_toggle_" .. feature.name, { feature.toggle }, true)
            ImGui.Spacing()
            ImGui.Separator()
            ImGui.Spacing()
        end
        draw_sections(feature.name, feature.sections)
    else
        draw_diagnostics()
    end
end

local function draw_bodycam_settings()
    if not ImGui.BeginTable(
        "bodycam_settings_layout",
        2,
        ImGuiTableFlags.BordersInnerV,
        vector2():set(0, 0),
        0) then
        return
    end

    ImGui.TableSetupColumn("Features", ImGuiTableColumnFlags.WidthFixed, 220, 0)
    ImGui.TableSetupColumn("Options", ImGuiTableColumnFlags.WidthStretch, 0, 0)
    ImGui.TableNextRow(ImGuiTableRowFlags.None, 0)
    ImGui.TableSetColumnIndex(0)
    draw_navigation()
    ImGui.TableSetColumnIndex(1)
    draw_selected_feature()
    ImGui.EndTable()
end

local function render_bodycam_window()
    ImGui.SetNextWindowSize(vector2():set(1020, 720), ImGuiCond.FirstUseEver)
    local expanded, visible = ImGui.Begin("Bodycam Settings", show_bodycam_window, ImGuiWindowFlags.None)
    show_bodycam_window = visible

    if expanded then
        if not load_bindings() then
            ImGui.TextColored(fcolor():set(1, 0.4, 0.4, 1), "Bodycam binding metadata is unavailable")
        else
            draw_bodycam_settings()
        end
    end
    ImGui.End()
end

if ImGui and ImGui.Groups and ImGui.Groups.Main and ImGui.Groups.Mods then
    ImGui.Groups.Main.Widget(function()
        if show_bodycam_window then
            render_bodycam_window()
        end
    end)

    ImGui.Groups.Mods.Widget(function()
        _, show_bodycam_window = ImGui.MenuItem("Bodycam", nil, show_bodycam_window, true)
    end)
end

function on_game_start()
    RegisterScriptCallback("actor_on_update", actor_on_update)
end
