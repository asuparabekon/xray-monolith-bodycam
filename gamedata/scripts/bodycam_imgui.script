local binding_descriptions = {
    camera_continuous_follow_enable = "Deadzone: the camera waits until the aim leaves the deadzone, then catches up. Reference follow: the camera follows the gun continuously with the Reference camera lag, in hip fire and ADS. The model also sets the scope eye with Bodycam scope effects: Deadzone eases the eye back to the centre of the scope; Reference follow shows the current eye.",
    camera_follow_lag_speed_min = "Reference follow: camera lag speed while the aim moves slowly. Lower trails further behind slow turns.",
    camera_follow_lag_speed_max = "Reference follow: camera lag speed while the aim moves fast. Lower trails further behind fast turns.",
    camera_follow_lag_response = "Reference follow: speed at which the camera lag speed moves between its slowest and fastest value.",
    camera_follow_aim_smoothing = "Reference follow: speed of the aim smoothing the camera follows. Higher follows the aim more directly.",
    fire_impulse_kick_drop = "Distance the weapon drops per shot at full strength, in metres.",
    fire_impulse_kick_back = "Distance the weapon comes back per shot at full strength, in metres.",
    fire_impulse_kick_pitch = "Angle the weapon pitches up per shot at full strength, in degrees.",
    fire_impulse_kick_roll = "Angle the weapon rolls away from the mouse movement per shot at full strength, in degrees.",
    camera_reference_roll = "Strength of camera roll: about 5 degrees while strafing, up to 8 in fast turns, and a small lean when sprinting. The weapon rolls with the camera. 0 removes it; 1 matches Reference.",
    camera_reference_shake = "Strength of camera shake from movement and mouse motion, both growing with speed. The weapon stays steady. 0 removes it; 1 matches Reference.",
    footstep_camera_enable = "Moves the head with each step, timed to the footstep sounds. Replaces the game's head bobbing and the sprint camera sway. Weapon sway is unchanged.",
    footstep_camera_bob = "Strength of the per-step head bob and sway. 0 removes it; 1 matches Reference.",
    footstep_camera_posture = "Strength of the head posture while moving: lower when walking, lower and forward when sprinting. 0 removes it; 1 matches Reference.",
    footstep_camera_sprint_lunge = "Strength of the head dive at the start of a sprint. Slower acceleration stretches it. 0 removes it; 1 matches Reference.",
    footstep_camera_ads = "Footstep camera strength while aiming. 0 removes it in ADS; 1 keeps full strength.",
    classic_recoil_enable = "Adds the Reference gun kick: the gun and both hands recoil together. Aim recoil and camera kick are unchanged. Fire Impulses stay on, scaled by Share with Reference recoil.",
    classic_recoil_hip_intensity = "Strength of Reference recoil at the hip. 0 removes it; 1 matches Reference. Blends with the ADS value as you aim.",
    classic_recoil_ads_intensity = "Strength of Reference recoil while aiming. 0 removes it; 1 matches Reference. Blends with the hip value as you aim.",
    classic_recoil_fire_impulse_share = "Share of the Fire Impulse kept while Reference recoil is on, so the two kicks do not stack. 0 leaves the whole kick to Reference recoil; 1 keeps the full Fire Impulse.",
    classic_regrip_enable = "Shifts the gun and both hands together when you aim, switch sights or fire. Weapon animations keep control of the hands.",
    directional_weapon_inertia_enable = "Lets the elbows settle after mouse movement without delaying the gun. Works alongside weapon inertia and STALKER 2 Style Arm IK.",
    movement_linked_handling_enable = "Moves the weapon with your acceleration, stops and footsteps. Does not change movement speed or stamina.",
    vm_lowering_enable = "Lowers the weapon while you walk.",
    stalker2_style_arm_ik_enable = "Adds wrist and arm motion that follows the mouse and your walking.",
