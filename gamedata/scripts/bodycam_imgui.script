local basic_names = {}
for _, section in ipairs(basic_sections) do
    for _, setting in ipairs(section.settings) do
        basic_names[setting[1]] = true
    end
end

local category_order = {
    "Camera",
    "Viewmodel",
    "Movement",
    "Sprint",
    "Impulses",
    "Viewmodel Lowering",
    "Bodycam Style Arm IK",
    "STALKER 2 Style Arm IK",
    "Layer Weights",
    "Debugging",
    "General",
}

