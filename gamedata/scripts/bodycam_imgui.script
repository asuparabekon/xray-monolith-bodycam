local function human_name(name)
    local words = {}
    for word in string.gmatch(name, "[^_]+") do
        local replacement = word_names[word]
        if replacement then
            table.insert(words, replacement)
        else
            table.insert(words, string.upper(string.sub(word, 1, 1)) .. string.sub(word, 2))
        end
    end
    return table.concat(words, " ")
end

local function category_for(name)
    if string.find(name, "stalker2_", 1, true) == 1 then
        return "STALKER 2 Style Arm IK"
    elseif string.find(name, "arm_compliance_", 1, true) == 1 or name == "bodycam_style_arm_ik_enable" then
        return "Bodycam Style Arm IK"
    elseif string.find(name, "vm_lowering_", 1, true) == 1 then
        return "Viewmodel Lowering"
    elseif string.find(name, "hip_camera_", 1, true) == 1 or string.find(name, "ads_camera_", 1, true) == 1 or
        string.find(name, "movement_camera_", 1, true) == 1 or name == "camera_decoupling_enable" then
        return "Camera"
    elseif string.find(name, "vm_", 1, true) == 1 then
        return "Viewmodel"
    elseif string.find(name, "movement_", 1, true) == 1 then
        return "Movement"
    elseif string.find(name, "sprint_transition_", 1, true) == 1 or string.find(name, "sprint_", 1, true) == 1 then
        return "Sprint"
    elseif string.find(name, "impulse", 1, true) or string.find(name, "fire_weapon", 1, true) or
        string.find(name, "landing_", 1, true) == 1 or string.find(name, "mouse_flick_", 1, true) == 1 then
        return "Impulses"
    elseif string.find(name, "layer_weight", 1, true) then
        return "Layer Weights"
    elseif string.find(name, "debug", 1, true) then
        return "Debugging"
    end
    return "General"
end

local function load_bindings()
    if bindings then
        return true
    end
    if not bodycam or not bodycam.get_bindings then
        return false
    end

    local ok, result = pcall(bodycam.get_bindings)
    if not ok or not result then
        return false
    end

    bindings = result
    for _, binding in ipairs(bindings) do
        binding_by_name[binding.name] = binding
    end
    return true
end

local function show_binding_tooltip(binding)
    if ImGui.BeginItemTooltip() then
        ImGui.PushTextWrapPos(430)
        ImGui.TextWrapped(binding_descriptions[binding.name] or ("Adjusts " .. human_name(binding.name) .. "."))
        ImGui.PopTextWrapPos()
        ImGui.Separator()
        ImGui.TextDisabled("Console: " .. binding.console_name)
        if binding.type == "float" then
            ImGui.Text(string.format("Minimum: %g    Maximum: %g", binding.min, binding.max))
        else
            ImGui.Text("Minimum: 0 (Off)    Maximum: 1 (On)")
        end
        ImGui.EndTooltip()
    end
end

local function float_format(binding)
    local span = binding.max - binding.min
    if span <= 0.5 then
        return "%.3f"
    elseif span <= 2.0 then
        return "%.2f"
    end
    return "%.1f"
end

local function drag_speed(binding)
    local span = binding.max - binding.min
    if span <= 0.5 then
        return 0.001
    elseif span <= 2.0 then
        return 0.01
    end
    return 0.1
end

local function draw_binding(binding, label, use_slider)
    ImGui.TableNextRow(ImGuiTableRowFlags.None, 0)
    ImGui.TableSetColumnIndex(0)
    ImGui.Text(label)
    show_binding_tooltip(binding)
    ImGui.TableSetColumnIndex(1)

    if binding.type == "bool" then
        local current = bodycam.get_bool(binding.name, false)
        local changed, value = ImGui.Checkbox("##" .. binding.name, current)
        show_binding_tooltip(binding)
        if changed then
            bodycam.set_bool(binding.name, value)
        end
        return
    end

    local current = bodycam.get_float(binding.name, 0)
    local changed, value
    if use_slider then
        changed, value = ImGui.SliderFloat("##" .. binding.name, current, binding.min, binding.max,
            float_format(binding), ImGuiSliderFlags.None)
    else
        changed, value = ImGui.DragFloat("##" .. binding.name, current, drag_speed(binding), binding.min,
            binding.max, float_format(binding), ImGuiSliderFlags.None)
    end
    show_binding_tooltip(binding)
    if changed then
        bodycam.set_float(binding.name, value)
    end
end

local function draw_settings_table(id, settings, use_slider)
    if not ImGui.BeginTable(id, 2, ImGuiTableFlags.None, vector2():set(0, 0), 0) then
        return
    end

    ImGui.TableSetupColumn("Setting", ImGuiTableColumnFlags.None, 0.62, 0)
    ImGui.TableSetupColumn("Value", ImGuiTableColumnFlags.None, 0.38, 0)
    for _, setting in ipairs(settings) do
        local binding = binding_by_name[setting[1]]
        if binding then
            draw_binding(binding, setting[2], use_slider)
        end
    end
    ImGui.EndTable()
end

local function draw_presets()
    if ImGui.Button("Balanced", vector2():set(110, 0)) then
        bodycam.apply_preset(1)
    end
    ImGui.SameLine(0, 8)
    if ImGui.Button("Stronger", vector2():set(110, 0)) then
        bodycam.apply_preset(2)
    end
    ImGui.SameLine(0, 8)
    if ImGui.Button("Cinematic", vector2():set(110, 0)) then
        bodycam.apply_preset(3)
    end
end

local function draw_basic_tab()
    draw_presets()
    ImGui.Spacing()
    for _, section in ipairs(basic_sections) do
        if ImGui.CollapsingHeader(section.name, ImGuiTreeNodeFlags.DefaultOpen) then
            draw_settings_table("bodycam_basic_" .. section.name, section.settings, true)
        end
    end
end

local function build_advanced_groups()
    local groups = {}
    for _, category in ipairs(category_order) do
        groups[category] = {}
    end

    for _, binding in ipairs(bindings) do
        if not basic_names[binding.name] then
            local category = category_for(binding.name)
            table.insert(groups[category], { binding.name, human_name(binding.name) })
        end
    end
    return groups
end

local function draw_advanced_tab()
    if not advanced_groups then
        advanced_groups = build_advanced_groups()
    end
    if ImGui.Button("Dump Runtime State", vector2():set(160, 0)) then
        bodycam.dump()
    end
    ImGui.Spacing()

    for _, category in ipairs(category_order) do
        local settings = advanced_groups[category]
        if #settings > 0 and ImGui.CollapsingHeader(category, ImGuiTreeNodeFlags.None) then
            draw_settings_table("bodycam_advanced_" .. category, settings, false)
        end
    end
end

local function render_bodycam_window()
    ImGui.SetNextWindowSize(vector2():set(860, 680), ImGuiCond.FirstUseEver)
    local expanded, visible = ImGui.Begin("Bodycam Settings", show_bodycam_window, ImGuiWindowFlags.None)
    show_bodycam_window = visible

    if expanded then
        if not load_bindings() then
            ImGui.TextColored(fcolor():set(1, 0.4, 0.4, 1), "Bodycam binding metadata is unavailable")
        elseif ImGui.BeginTabBar("bodycam_settings_tabs", ImGuiTabBarFlags.None) then
            local basic_open = ImGui.BeginTabItem("Basic", true, ImGuiTabItemFlags.None)
            if basic_open then
                draw_basic_tab()
                ImGui.EndTabItem()
            end

            local advanced_open = ImGui.BeginTabItem("Advanced", true, ImGuiTabItemFlags.None)
            if advanced_open then
                draw_advanced_tab()
                ImGui.EndTabItem()
            end
            ImGui.EndTabBar()
        end
    end
    ImGui.End()
end

if ImGui and ImGui.Groups and ImGui.Groups.Main and ImGui.Groups.Mods then
    ImGui.Groups.Main.Widget(function()
        if show_bodycam_window then
            render_bodycam_window()
        end
    end)

    ImGui.Groups.Mods.Widget(function()
        _, show_bodycam_window = ImGui.MenuItem("Bodycam", nil, show_bodycam_window, true)
    end)
end
