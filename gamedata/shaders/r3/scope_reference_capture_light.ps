// A reflex drawn into the eyepiece capture (a hybrid magnifier) over the Reference image (svp_reticle_emission.cpp).
// The reflex left its light in capture-space targets; this pass shows it where the image shows the capture, through
// the image's pupil transmission: the reflex's own light into the frame, its atlas reticle core and glow source into
// the glow targets.
#include "scope_common.h"
Texture2D scope_reference_ocular;     // a: the image's pupil transmission
Texture2D scope_reference_capture_tc; // xy: the capture coordinate the image shows, w: 1 where the image drew
Texture2D s_capture_light;            // the reflex as it draws over the capture
Texture2D s_capture_emission;         // its atlas reticle core, while the glow has its own targets
Texture2D s_capture_glow;             // and that core weighted by the atlas's glow strength
Texture2D scope_reference_visible_glass; // w > 1.5: the frontmost visible lens glass (deferred glass)
uniform float4 reticle_capture_glow;  // x 1 = the glow targets are bound at 1 and 2, y 1 = deferred glass

struct ScopeReferenceCaptureLight
{
    float4 light : SV_Target0;
    float4 core : SV_Target1;
    float4 glow : SV_Target2;
};

ScopeReferenceCaptureLight main(v_out input)
{
    const int3 px = int3(input.hpos.xy, 0);
    // deferred glass draws the image without a depth test; the glass tag keeps this pass to the visible lens
    if (reticle_capture_glow.y > 0.5 && !(scope_reference_visible_glass.Load(px).w > 1.5))
        discard;
    const float4 capture = scope_reference_capture_tc.Load(px);
    const float shown = saturate(scope_reference_ocular.Load(px).a) * capture.w;
    ScopeReferenceCaptureLight output = (ScopeReferenceCaptureLight)0;
    if (shown <= 0.0)
        discard;
    output.light = float4(s_capture_light.SampleLevel(smp_rtlinear, capture.xy, 0).rgb * shown, 0);
    if (reticle_capture_glow.x > 0.5)
    {
        output.core = float4(s_capture_emission.SampleLevel(smp_rtlinear, capture.xy, 0).rgb * shown, 1);
        output.glow = float4(s_capture_glow.SampleLevel(smp_rtlinear, capture.xy, 0).rgb * shown, 1);
    }
    return output;
}
