// The stock reticle, with its alpha limited by the optical image's pupil transmission.
#define SCOPE_REFERENCE_MARK_ONLY
// drawn with scope_phase = SCOPE_PHASE_RETICLE only: just the reticle phase of scope_color_write compiles
#define SCOPE_COLOR_WRITE_PHASES SCOPE_PHASE_RETICLE
#define main scope_color_write_main
#include "scope_color_write.ps"
#undef main
#ifndef SCOPE_REFERENCE_OCULAR_DECLARED // declared by the atlas-aware scope_custom_reticle.h
Texture2D scope_reference_ocular;
#endif
#ifdef RETICLE_ATLAS_EMISSION_PASS
#include "reticle_emission_out.h"
ReticleEmissionOut main(v_out input)
#else
float4 main(v_out input) : SV_Target
#endif
{
#ifdef SCOPE_REFERENCE_DEFERRED_RETICLE
    // The reticle plane lies behind the curved glass, so a depth test would
    // reject it. The glass G-buffer tag marks the frontmost visible lens pixels.
    if (!(scope_reference_visible_glass.Load(int3(input.hpos.xy,0)).w > 1.5)) discard;
#endif
#ifdef RETICLE_ATLAS_EMISSION_PASS
    // the glow core and its glow source (reticle_atlas.h), from the reticle alone; without the atlas-aware reticle
    // there is none
    ReticleEmissionOut o = (ReticleEmissionOut)0;
#ifdef RETICLE_ATLAS_H
    scope = new_Scope(input);
    const float4 mark = scope_custom_reticle(scope);
    const float pupil = saturate(scope_reference_ocular.Load(int3(input.hpos.xy,0)).a);
    o.core = float4(mark.rgb * pupil, mark.a);
    o.glow = float4(reticle_atlas_glow_source.rgb * pupil, reticle_atlas_glow_source.a);
#else
    discard;
#endif
    return o;
#else
    float4 mark = scope_color_write_main(input);
    mark.a *= saturate(scope_reference_ocular.Load(int3(input.hpos.xy,0)).a);
    return mark;
#endif
}
